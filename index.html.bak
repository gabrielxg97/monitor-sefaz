  <!-- MODAL RECEBIMENTO (PAGAMENTO PARCIAL/TOTAL) -->
  <div class="modal-overlay" id="modal-recebimento-overlay"></div>
  <div class="modal" id="modal-recebimento" style="width:800px;max-width:95vw;padding:0">
    <div style="display:flex;height:600px;max-height:80vh">
      <!-- Coluna Esquerda: Itens SelecionÃ¡veis -->
      <div style="width:50%;border-right:1px solid var(--border-soft);display:flex;flex-direction:column">
        <div style="padding:20px;border-bottom:1px solid var(--border-soft);background:var(--card-bg);border-radius:12px 0 0 0">
          <h3 style="font-family:'Playfair Display',serif;font-size:20px;margin-bottom:4px">Itens para Pagamento</h3>
          <div style="font-size:12px;color:var(--text-dim)">Selecione os itens que deseja receber agora.</div>
        </div>
        <div style="padding:10px 20px;background:rgba(255,255,255,0.03);border-bottom:1px solid var(--border-soft);display:flex;justify-content:space-between;align-items:center">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;font-weight:600">
            <input type="checkbox" id="chk-recebimento-todos" onchange="toggleRecebimentoTodos(this)"> Selecionar Todos
          </label>
        </div>
        <div id="recebimento-itens-list" style="flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:12px"></div>
      </div>
      <!-- Coluna Direita: Pagamento -->
      <div style="width:50%;display:flex;flex-direction:column;background:var(--content-bg);border-radius:0 12px 12px 0">
        <div style="padding:20px;border-bottom:1px solid var(--border-soft)">
          <div style="font-size:13px;color:var(--text-dim)">Total Selecionado</div>
          <div id="recebimento-total-selecionado" style="font-size:32px;font-weight:700;color:var(--accent)">R$ 0,00</div>
          
          <div style="margin-top:16px;display:flex;gap:12px;align-items:center">
             <div style="font-size:12px;color:var(--text-dim)">Restante a Pagar da(s) Comanda(s):</div>
             <div id="recebimento-total-restante" style="font-size:14px;font-weight:600;color:var(--danger)">R$ 0,00</div>
          </div>
        </div>
        
        <div style="flex:1;overflow-y:auto;padding:20px">
          <div class="form-group" style="margin-bottom:16px">
            <label class="form-label">Dividir Selecionado por N pessoas (opcional)</label>
            <div style="display:flex;gap:8px">
              <input type="number" id="recebimento-dividir" class="form-input" min="1" value="1" oninput="calcularRecebimento()" style="width:80px;text-align:center" />
              <div id="recebimento-valor-dividido" style="flex:1;background:rgba(255,255,255,0.05);border-radius:6px;display:flex;align-items:center;justify-content:center;font-weight:600;color:var(--accent)">R$ 0,00 por pessoa</div>
            </div>
          </div>
          
          <div style="font-size:13px;font-weight:600;margin-bottom:12px;color:var(--text)">Valor a Receber Agora</div>
          <input type="number" id="recebimento-valor-pagar" class="form-input" style="font-size:24px;font-weight:bold;height:60px;text-align:center;margin-bottom:20px" value="0.00" oninput="validarValorRecebimento()" />
          
          <div class="form-group" style="margin-bottom:20px">
            <label class="form-label">Nome do Pagador (opcional)</label>
            <input type="text" id="recebimento-nome-pagador" class="form-input" placeholder="Ex: JoÃ£o Silva" />
          </div>

          <div style="font-size:13px;font-weight:600;margin-bottom:12px;color:var(--text)">Forma de Pagamento</div>
          <div id="recebimento-formas-pagamento" style="display:grid;grid-template-columns:1fr 1fr;gap:8px"></div>
          
          <div id="recebimento-troco-container" style="display:none;margin-top:20px;padding:16px;background:rgba(92,184,92,0.05);border:1px solid rgba(92,184,92,0.2);border-radius:8px">
            <div class="form-group" style="margin-bottom:12px">
              <label class="form-label">Valor Entregue pelo Cliente (R$)</label>
              <input type="number" id="recebimento-valor-entregue" class="form-input" style="font-size:18px;font-weight:bold" placeholder="0.00" oninput="calcularTroco()" />
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px">
              <span style="font-size:13px;font-weight:600;color:var(--text-dim)">Troco a Devolver:</span>
              <span id="recebimento-troco-valor" style="font-size:24px;font-weight:bold;color:var(--success)">R$ 0,00</span>
            </div>
          </div>
        </div>
        
        <div style="padding:20px;border-top:1px solid var(--border-soft);display:flex;justify-content:space-between;gap:8px">
          <button class="btn btn-ghost" onclick="fecharModalRecebimento()">Cancelar</button>
          <div style="display:flex;gap:8px">
            <button id="btn-salvar-pagamento" class="btn btn-ghost" style="border:1px solid var(--accent);color:var(--accent)" onclick="confirmarRecebimento(false)" disabled>Salvar Pagamento</button>
            <button id="btn-confirmar-recebimento" class="btn btn-primary" style="background:var(--success);border-color:var(--success)" onclick="confirmarRecebimento(true)" disabled>Receber e Finalizar</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CARDÃPIO DIGITAL -->
  <div class="page" id="page-vendas-cardapio-digital">
    <div class="page-header" style="justify-content:space-between">
      <div>
        <div class="page-title">CardÃ¡pio Digital</div>
        <div class="page-sub">ConfiguraÃ§Ãµes do menu online para delivery e retirada</div>
      </div>
      <button class="btn btn-primary" onclick="salvarConfigCardapio()">Salvar ConfiguraÃ§Ãµes</button>
    </div>
    
    <div style="display:flex;gap:24px;align-items:flex-start">
      <!-- Coluna Principal -->
      <div style="flex:2;display:flex;flex-direction:column;gap:24px">
        
        <div class="card" style="padding:24px">
          <h3 style="margin-top:0;margin-bottom:16px;font-size:16px;font-family:'Playfair Display',serif">Dados da Loja</h3>
          <div class="form-group">
            <label class="form-label">Nome da Loja</label>
            <input type="text" id="f-cardapio-nome" class="form-input" placeholder="Ex: FoodFlow Burguer" />
          </div>
          <div class="form-group" style="margin-top:12px">
            <label class="form-label">EndereÃ§o Completo</label>
            <input type="text" id="f-cardapio-endereco" class="form-input" placeholder="Rua, NÃºmero, Bairro, Cidade - Estado" />
          </div>
          <div style="display:flex;gap:12px;margin-top:12px">
            <div class="form-group" style="flex:1">
              <label class="form-label">Instagram</label>
              <input type="text" id="f-cardapio-insta" class="form-input" placeholder="@seunegocio" />
            </div>
            <div class="form-group" style="flex:1">
              <label class="form-label">WhatsApp (Pedidos)</label>
              <input type="text" id="f-cardapio-wpp" class="form-input" placeholder="Ex: 5511999999999" />
            </div>
          </div>
        </div>

        <div class="card" style="padding:24px">
          <h3 style="margin-top:0;margin-bottom:16px;font-size:16px;font-family:'Playfair Display',serif">OperaÃ§Ã£o e Entregas</h3>
          <div style="display:flex;gap:12px;margin-bottom:12px">
            <div class="form-group" style="flex:1">
              <label class="form-label" style="font-weight:600">HorÃ¡rios de Atendimento</label>
              <div id="f-cardapio-horarios-container" style="display:flex;flex-direction:column;gap:8px;margin-top:8px">
                <!-- Horarios gerados por JS -->
              </div>
            </div>
          </div>
          <div style="display:flex;gap:12px;margin-bottom:12px;margin-top:16px;border-top:1px dashed var(--border-soft);padding-top:16px">
            <div class="form-group" style="flex:1">
              <label class="form-label">OpÃ§Ãµes de ServiÃ§o</label>
              <div style="display:flex;gap:16px;margin-top:8px">
                <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                  <input type="checkbox" id="f-cardapio-srv-entrega" checked> Aceita Entrega
                </label>
                <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                  <input type="checkbox" id="f-cardapio-srv-retirada" checked> Aceita Retirada
                </label>
              </div>
            </div>
          </div>
          <div style="display:flex;gap:12px;margin-bottom:12px;margin-top:16px;border-top:1px dashed var(--border-soft);padding-top:16px">
            <div class="form-group" style="flex:1">
              <label class="form-label">Pedido MÃ­nimo (R$)</label>
              <input type="number" id="f-cardapio-minimo" class="form-input" placeholder="0.00" step="0.01" />
            </div>
          </div>
          <div style="display:flex;gap:12px;margin-bottom:16px">
            <div class="form-group" style="flex:1">
              <label class="form-label">Tempo MÃ©dio - Entrega</label>
              <input type="text" id="f-cardapio-tempo-ent" class="form-input" placeholder="Ex: 45-60 min" />
            </div>
            <div class="form-group" style="flex:1">
              <label class="form-label">Tempo MÃ©dio - Retirada</label>
              <input type="text" id="f-cardapio-tempo-ret" class="form-input" placeholder="Ex: 20-30 min" />
            </div>
          </div>
          
          <div style="border-top:1px dashed var(--border-soft);padding-top:16px">
            <label class="form-label" style="font-weight:600">Regras de Entrega</label>
            <div style="display:flex;gap:16px;margin-bottom:12px">
              <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                <input type="radio" name="cardapio-tipo-entrega" value="raio" checked onchange="toggleCardapioTipoEntrega()" /> Por Raio (KM)
              </label>
              <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                <input type="radio" name="cardapio-tipo-entrega" value="bairro" onchange="toggleCardapioTipoEntrega()" /> Por Bairros
              </label>
            </div>
            
            <div id="cardapio-entrega-raio">
              <div style="font-size:12px;color:var(--text-dim);margin-bottom:8px">Faixas de KM atendidas e suas respectivas taxas:</div>
              <div id="cardapio-raios-list" style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px"></div>
              <button class="btn btn-ghost" style="padding:6px 12px;font-size:12px" onclick="adicionarRaioCardapio()">+ Adicionar Faixa de KM</button>
            </div>
            
            <div id="cardapio-entrega-bairro" style="display:none">
              <div style="font-size:12px;color:var(--text-dim);margin-bottom:8px">Bairros atendidos e suas respectivas taxas:</div>
              <div id="cardapio-bairros-list" style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px"></div>
              <button class="btn btn-ghost" style="padding:6px 12px;font-size:12px" onclick="adicionarBairroCardapio()">+ Adicionar Bairro</button>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Coluna Lateral -->
      <div style="flex:1;display:flex;flex-direction:column;gap:24px">
        <div class="card" style="padding:24px">
          <h3 style="margin-top:0;margin-bottom:16px;font-size:16px;font-family:'Playfair Display',serif">AparÃªncia</h3>
          <div class="form-group">
            <label class="form-label">Logo da Loja</label>
            <div style="width:80px;height:80px;border-radius:50%;background:var(--bg);border:1px dashed var(--border-soft);display:flex;align-items:center;justify-content:center;margin-bottom:8px;cursor:pointer;overflow:hidden">
              <span style="font-size:24px;color:var(--text-dim)">ðŸ“¸</span>
            </div>
            <div style="font-size:11px;color:var(--text-dim)">Clique para alterar a logo</div>
          </div>
          <div class="form-group" style="margin-top:16px">
            <label class="form-label">Banner (Capa)</label>
            <div style="width:100%;height:100px;border-radius:8px;background:var(--bg);border:1px dashed var(--border-soft);display:flex;align-items:center;justify-content:center;margin-bottom:8px;cursor:pointer">
              <span style="font-size:24px;color:var(--text-dim)">ðŸ–¼ï¸</span>
            </div>
            <div style="font-size:11px;color:var(--text-dim)">Clique para alterar o banner</div>
          </div>
        </div>
        
        <div class="card" style="padding:24px">
          <h3 style="margin-top:0;margin-bottom:16px;font-size:16px;font-family:'Playfair Display',serif">Link do CardÃ¡pio</h3>
          <div class="form-group">
            <label class="form-label">DomÃ­nio Personalizado</label>
            <input type="text" id="f-cardapio-dominio" class="form-input" placeholder="seunegocio.com.br" />
            <div style="font-size:11px;color:var(--text-dim);margin-top:4px">Seu cardÃ¡pio estarÃ¡ disponÃ­vel em <b>foodflow.app/sua-loja</b> ou no domÃ­nio acima.</div>
          </div>
          <button class="btn btn-ghost" style="width:100%;margin-top:12px;border:1px solid var(--accent);color:var(--accent)">ðŸ”— Copiar Link do CardÃ¡pio</button>
        </div>
      </div>
    </div>
  </div>

  <!-- FORMAS DE PAGAMENTO -->
  <div class="page" id="page-vendas-pagamentos">
    <div class="page-header">
      <div>
        <div class="page-title">Formas de Pagamento</div>
        <div class="page-sub">Gerencie as opÃ§Ãµes exibidas no caixa</div>
      </div>
      <button class="btn btn-primary" onclick="adicionarPagamento()">+ Novo Pagamento</button>
    </div>
    <div class="card" style="padding:24px;max-width:600px">
      <div id="pagamentos-list" style="display:flex;flex-direction:column;gap:12px"></div>
    </div>
  </div>
</main>
<script src="script.js"></script>
<div id="toast-container"></div>
</body>
</html>

