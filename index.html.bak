             <button class="btn btn-ghost" id="pdv-btn-voltar" style="display:none;padding:8px 12px" onclick="pdvVoltar()">â† Voltar</button>
             <input type="text" id="pdv-search" class="form-input" placeholder="Buscar produto..." style="flex:1" oninput="handlePDVSearch()" />
           </div>
           <!-- NAV BREADCRUMB -->
           <div id="pdv-breadcrumb" style="font-size:14px;color:var(--text-dim);margin-bottom:16px;font-weight:600">Categorias</div>
           <!-- GRID DE ITENS (Cats, Subcats, Prods) -->
           <div id="pdv-products-grid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));gap:16px;flex:1;align-content:flex-start"></div>
        </div>
        <!-- CARRINHO -->
        <div style="flex:1;background:var(--sidebar-bg);display:flex;flex-direction:column">
           <div style="padding:20px;border-bottom:1px solid var(--border-soft);font-weight:600;display:flex;justify-content:space-between;align-items:center">
             <span id="pdv-cart-title">Cupom (Venda Direta)</span>
             <button id="pdv-btn-close-comanda" class="btn btn-ghost" style="display:none;padding:4px 8px;font-size:11px" onclick="switchCaixaTab('comandas', document.querySelector('.modal-tab:nth-child(2)'))">Sair da Comanda</button>
           </div>
           <div id="pdv-cart" style="flex:1;overflow-y:auto;padding:20px">
             <div class="empty-state" style="padding:40px 0"><p>Carrinho vazio</p></div>
           </div>
           <div style="padding:20px;border-top:1px solid var(--border-soft)">
             <div style="display:flex;justify-content:space-between;margin-bottom:16px;font-size:18px;font-weight:600;color:var(--accent)">
               <span>Total</span>
               <span id="pdv-total">R$ 0,00</span>
             </div>
             
             <!-- BOTOES DE ACAO DO CARRINHO -->
             <div id="pdv-cart-actions-direta" style="display:flex;flex-direction:column">
               <button class="btn btn-primary" style="width:100%;padding:14px" onclick="finalizarVendaDireta()">Finalizar Venda</button>
             </div>
             <div id="pdv-cart-actions-comanda" style="display:none;flex-direction:column;gap:8px">
               <button id="btn-lancar-itens" class="btn btn-primary" style="width:100%" onclick="salvarItensComanda()">LanÃ§ar Itens na Comanda</button>
               <button id="btn-pre-fechamento" class="btn btn-ghost" style="width:100%;background:rgba(92,184,92,0.1);color:var(--success)" onclick="preFechamentoComanda()">Imprimir PrÃ©-fechamento</button>
               <button id="btn-finalizar-comanda" class="btn btn-primary" style="width:100%;background:var(--success);border-color:var(--success)" onclick="finalizarComanda()">Finalizar e Receber</button>
               <button id="btn-bloquear-comanda" class="btn btn-ghost" style="width:100%;color:var(--danger);border:1px solid var(--danger)" onclick="bloquearComanda()">Bloquear Comanda (Perda/Roubo)</button>
               <button id="btn-desbloquear-comanda" class="btn btn-ghost" style="width:100%;display:none;color:var(--accent);border:1px dashed var(--accent)" onclick="desbloquearComanda()">Desbloquear Comanda</button>
             </div>
           </div>
        </div>
      </div>

      <!-- COMANDAS -->
      <div class="caixa-pane" id="pane-comandas" style="display:none;padding:24px;height:100%;overflow-y:auto;flex-direction:column">
        <div id="pdv-comandas-metrics" style="display:flex;gap:16px;margin-bottom:20px"></div>
        <div id="pdv-comandas-grid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(110px, 1fr));gap:16px"></div>
      </div>

      <!-- MESAS -->
      <div class="caixa-pane" id="pane-mesas" style="display:none;padding:24px;height:100%;overflow-y:auto">
        <div id="pdv-mesas-grid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(120px, 1fr));gap:16px"></div>
      </div>

    </div>
  </div>

